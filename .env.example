# QuantroBill POS — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# MongoDB Atlas connection string (rotate password if previously leaked)
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<AppName>
MONGODB_DATABASE_NAME=petbharke

# JWT Signing Key (minimum 64 characters, generate with: openssl rand -base64 64)
JWT_KEY=<your-jwt-signing-key-min-64-chars>
JWT_ISSUER=PetBharkeAPI
JWT_AUDIENCE=PetBharkeClient

# CORS Allowed Origins (comma-separated or use indexed env vars)
ALLOWED_ORIGIN_0=http://localhost:5173

# Swagger UI (set to true only for development/staging)
SWAGGER_ENABLED=false

# Database Seeding (set to true to force seed on first run in production)
FORCE_SEED=false
