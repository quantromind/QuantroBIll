# QuantroBill POS — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials to version control.

# MongoDB Atlas connection string
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/QuantroBill?retryWrites=true&w=majority
MONGODB_DATABASE_NAME=QuantroBill

# JWT Signing Key
JWT_KEY=QuantromindSuperSecureEnterpriseKey2026!998877665544332211#ProductionJwtSecret
JWT_ISSUER=QuantroBillAPI
JWT_AUDIENCE=QuantroBillClient

# CORS Allowed Origins
ALLOWED_ORIGIN_0=https://quantrobill.quantromind.com
ALLOWED_ORIGIN_1=http://localhost:5173

# Swagger UI
SWAGGER_ENABLED=true

# Database Seeding (Ensures SuperAdmin exists)
FORCE_SEED=true
