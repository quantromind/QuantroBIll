{
  "name": "quantrobill-desktop",
  "version": "1.0.0",
  "description": "QuantroBill Next-Gen Desktop POS with Thermal Printing and Offline Capability",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "pos",
    "restaurant",
    "electron",
    "desktop",
    "thermal-printer"
  ],
  "author": "QuantroBill Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.quantrobill.desktoppos",
    "productName": "QuantroBill Desktop POS",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    }
  }
}
