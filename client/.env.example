# PetBharke POS Environment Configuration Example
# Set this to match your environment:
#
# Option A: Local development (default)
# VITE_API_BASE_URL=http://localhost:5000/api
#
# Option B: Single domain production deployment with Nginx / Caddy reverse proxy
# VITE_API_BASE_URL=/api
#
# Option C: Separate API domain / subdomain in production
# VITE_API_BASE_URL=https://api.yourdomain.com/api

VITE_API_BASE_URL=http://localhost:5000/api
